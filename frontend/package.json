{
  "name": "city-gap-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-cesium-assets.mjs",
    "predev": "node scripts/sync-cesium-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-cesium-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "audit:plateau-native": "node scripts/audit-plateau-native.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "audit:visual-identity": "node scripts/audit-visual-identity.mjs",
    "audit:harbor-accessibility": "node scripts/audit-harbor-atlas-accessibility.mjs",
    "audit:public-first-run": "node scripts/audit-public-first-run.mjs",
    "capture:advanced": "node scripts/capture-current.mjs",
    "capture:map-section-refinement": "node scripts/capture-map-section-refinement.mjs",
    "capture:harbor-simulations": "node scripts/capture-harbor-atlas-simulations.mjs",
    "capture:presentation": "node scripts/capture-presentation-assets.mjs",
    "record:demo": "node scripts/record-presentation-demo.mjs",
    "verify:presentation": "node scripts/verify-presentation-assets.mjs",
    "verify:demo": "node scripts/verify-demo-video.mjs",
    "test:guided": "node scripts/test-guided-spatial.mjs && node scripts/test-guided-advanced-transition.mjs",
    "test:data-upgrade": "node scripts/test-guided-advanced-transition.mjs",
    "profile:guided": "node scripts/profile-guided-spatial.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "cesium": "1.121.0",
    "maplibre-gl": "6.6.0",
    "proj4": "^2.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@gltf-transform/core": "3.10.1",
    "@gltf-transform/extensions": "3.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "4.10.3",
    "draco3dgltf": "1.5.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright-core": "^1.61.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@cesium/engine": "11.0.0",
    "@cesium/widgets": "8.0.0",
    "@zip.js/zip.js": "2.7.34"
  }
}
