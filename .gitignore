.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.env
!.env.example

# Downloaded source data and intermediate artifacts
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Generated analysis outputs (keep only documentation placeholders)
analysis/outputs/**
!analysis/outputs/.gitkeep
!analysis/outputs/real/
!analysis/outputs/real/**
!analysis/outputs/benchmarks/
!analysis/outputs/benchmarks/validation_cost.json
# Detailed building estimates remain local until municipal/privacy review.
analysis/outputs/real/*.parquet
analysis/outputs/real/validation/internal/
# Large per-mesh context tables remain regenerable municipal artifacts.
analysis/outputs/real/*_mesh_plateau_context.csv

# Frontend/build artifacts
node_modules/
frontend/dist/
frontend/public/cesium/
.DS_Store

# Local capture/video staging. Versioned evidence belongs under docs/assets/.
/tmp/
/temp/
/*-frames/
/*.webm
/*.y4m
