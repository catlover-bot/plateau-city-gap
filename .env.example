CITYGAP_POSTGRES_DB=citygap
CITYGAP_POSTGRES_USER=citygap
CITYGAP_POSTGRES_PASSWORD=replace-for-shared-environments
CITYGAP_POSTGRES_PORT=5432
CITYGAP_API_PORT=8000
CITYGAP_FRONTEND_PORT=8080
# municipal: authenticated service UI. public_showcase: read-only frontend surface.
VITE_CITYGAP_SURFACE=municipal
# municipal, public-showcase or combined. Use municipal for the service deployment.
CITYGAP_API_SURFACE=municipal
CITYGAP_APPLICATION_VERSION=unversioned-development
CITYGAP_APPLICATION_COMMIT=
# Leave empty behind bundled nginx; set an origin for split deployments.
VITE_CITYGAP_API_BASE_URL=
CITYGAP_ENVIRONMENT=development
CITYGAP_AUTH_MODE=development
CITYGAP_REQUIRED_CITY_ID=
CITYGAP_OIDC_ISSUER=
CITYGAP_OIDC_AUDIENCE=
# Set true only after the deployment injects and tests a signature-verifying OIDC adapter.
CITYGAP_OIDC_VERIFIER_CONFIGURED=false
CITYGAP_WORKER_ID=compose-worker
CITYGAP_JOB_STAGE_TIMEOUT_SECONDS=3600
# Must exceed the longest configured stage timeout; abandoned claims are requeued or failed.
CITYGAP_JOB_STALE_AFTER_SECONDS=3900
CITYGAP_BACKUP_DIRECTORY=
CITYGAP_BACKUP_COMMAND_VERIFIED=false
CITYGAP_TILE_CACHE_ITEMS=512
# Immutable official-source bytes: local for development, s3_compatible for production.
CITYGAP_OPEN_DATA_STORAGE_PROVIDER=local
CITYGAP_OPEN_DATA_STORAGE_DIRECTORY=/app/var/open-data
CITYGAP_OPEN_DATA_S3_ENDPOINT=
CITYGAP_OPEN_DATA_S3_BUCKET=
CITYGAP_OPEN_DATA_S3_PREFIX=citygap-open-data
# local is implemented. s3_compatible remains unavailable until an adapter is configured.
CITYGAP_ATTACHMENT_PROVIDER=local
CITYGAP_ATTACHMENT_DIRECTORY=/app/var/attachments
